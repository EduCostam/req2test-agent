{
  "name": "req2test-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "tsx apps/api/src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/apps/api/src/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:postgres": "tsx scripts/check-postgres.ts",
    "db:migrate": "tsx db/migrate.ts",
    "eval:smoke": "tsx packages/evals/src/smoke.ts"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.3",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "3.2.7",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.7"
  }
}
